# =============================================================================
# Toonflow 一键部署配置模板
# 复制为 .env 后按需修改：cp .env.example .env
# 修改后重启生效：docker compose up -d
# =============================================================================

# ---------- 对外访问 ----------
# 宿主机映射端口（容器内固定 10588）。若本机已占用 10588，可改成 10589 等。
APP_PORT=10588

# ---------- 品牌化（白标）配置 ----------
# 站点名称（显示在标题/登录页等）
SITE_NAME=ToonFlow
# Logo 图片 URL（可留空，使用默认）
LOGO_URL=
# 主题色（CSS 颜色值，如 #FF0000）
PRIMARY_COLOR=#0052D9
# ICP 备案号（可留空）
ICP_NO=
# 客服联系方式（可留空）
CUSTOMER_SERVICE=
# 是否开放注册（1=开放 / 0=关闭）
REGISTER_OPEN=1
# 站点公告（可留空）
ANNOUNCEMENT=

# ---------- 管理员 ----------
# 可选：覆盖内置管理员（admin）密码。
# 注意：首次启动时管理员由应用创建（默认 admin123），此后若设置本项，重启容器即生效。
# 留空则使用默认密码 admin123（首次登录后请在运营后台修改）。
ADMIN_PASSWORD=
